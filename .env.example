POSTGRES_PASSWORD=replace-with-long-random-value
APAS_API_PASSWORD=replace-with-different-long-random-value
APAS_AUTH_PASSWORD=replace-with-different-long-random-value
APAS_INGESTION_PASSWORD=replace-with-different-long-random-value
APAS_AUDIT_PASSWORD=replace-with-different-long-random-value
APAS_RUNTIME_MODE=demo
# Required only for APAS_RUNTIME_MODE=production:
OIDC_ISSUER=https://issuer.example
OIDC_AUDIENCE=apas
OIDC_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----
EVIDENCE_SIGNING_PRIVATE_KEY=replace-with-escaped-ed25519-pem
