name: security-ci
on: [push, pull_request]
jobs:
  test:
    runs-on: ubuntu-latest
    services:
      postgres:
        image: pgvector/pgvector:pg16
        env: {POSTGRES_PASSWORD: postgres, POSTGRES_DB: apas}
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U postgres -d apas" --health-interval 5s --health-timeout 5s --health-retries 10
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with: {python-version: "3.12"}
      - run: pip install -e '.[dev]'
      - name: Apply migrations and provision runtime login
        env: {PGPASSWORD: postgres}
        run: |
          psql -h localhost -U postgres -d apas -f app/db/migrations/001_v3.sql
          psql -h localhost -U postgres -d apas -f app/db/migrations/002_v4_hardening.sql
          psql -h localhost -U postgres -d apas -f scripts/seed_postgres.sql
          psql -h localhost -U postgres -d apas <<'SQL'
          CREATE ROLE apas_live_test LOGIN PASSWORD 'ci-ephemeral' NOSUPERUSER NOBYPASSRLS;
          GRANT apas_api_reader TO apas_live_test;
          SQL
      - run: pytest
        env: {TEST_DATABASE_URL: "postgresql+psycopg://apas_live_test:ci-ephemeral@localhost:5432/apas"}
      - run: python scripts/evaluate.py
      - run: ruff check app tests scripts --select F,E9
